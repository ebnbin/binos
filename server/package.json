{
  "name": "@binos/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "watch": "tsx watch src/index.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json scripts/tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "services": "node scripts/services.ts",
    "deployed": "node scripts/deployed.ts",
    "preview": "node scripts/preview.ts",
    "protocol": "node scripts/protocol.ts",
    "postinstall": "node scripts/prepare-pty.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "diff": "^9.0.0",
    "hono": "^4.13.13",
    "node-pty": "^1.1.0",
    "playwright-core": "^1.64.1",
    "ws": "^8.22.0",
    "youtubei.js": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "oxlint": "^1.88.0",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}
