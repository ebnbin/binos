{
  "name": "binos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "services": "node scripts/services.ts",
    "deployed": "node scripts/deployed.ts",
    "preview": "node scripts/preview.ts",
    "protocol": "node scripts/protocol.ts",
    "postinstall": "node scripts/prepare-pty.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxlint": "^1.88.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}
